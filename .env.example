# Archivo de ejemplo para configurar variables de entorno
# Copiar este archivo y configurar según tu entorno

# ============================================
# OPCIÓN 1: Variables Individuales
# ============================================
# Recomendado para SQL Server Authentication

# Servidor SQL Server (con puerto si es diferente al default)
# Ejemplos:
#   - localhost
#   - .\SQLEXPRESS
#   - 192.168.1.100,1433
#   - miservidor.ejemplo.com,1433
TRIVIA_DB_SERVER=localhost

# Nombre de la base de datos
TRIVIA_DB_DATABASE=TriviaDB

# Usuario de SQL Server (solo para SQL Server Authentication)
TRIVIA_DB_USER=sa

# Contraseña (solo para SQL Server Authentication)
TRIVIA_DB_PASSWORD=MiPassword123

# ============================================
# OPCIÓN 2: Connection String Completo
# ============================================
# Usar si prefieres tener todo en una sola variable

# Ejemplo con SQL Server Authentication:
# TRIVIA_CONNECTION_STRING=Server=192.168.1.100,1433;Database=TriviaDB;User Id=sa;Password=MiPassword123;TrustServerCertificate=true;

# Ejemplo con Windows Authentication:
# TRIVIA_CONNECTION_STRING=Server=localhost;Database=TriviaDB;Integrated Security=true;TrustServerCertificate=true;

# ============================================
# CÓMO CONFIGURAR LAS VARIABLES
# ============================================

# WINDOWS (PowerShell) - Sesión actual
# $env:TRIVIA_DB_SERVER="192.168.1.100,1433"
# $env:TRIVIA_DB_DATABASE="TriviaDB"
# $env:TRIVIA_DB_USER="sa"
# $env:TRIVIA_DB_PASSWORD="MiPassword123"

# WINDOWS (CMD) - Sesión actual
# set TRIVIA_DB_SERVER=192.168.1.100,1433
# set TRIVIA_DB_DATABASE=TriviaDB
# set TRIVIA_DB_USER=sa
# set TRIVIA_DB_PASSWORD=MiPassword123

# WINDOWS - Variables del sistema (permanentes)
# 1. Buscar "Variables de entorno" en el menú inicio
# 2. Click en "Variables de entorno"
# 3. En "Variables de usuario" o "Variables del sistema"
# 4. Click "Nueva" y agregar cada variable

# LINUX/MAC
# export TRIVIA_DB_SERVER="192.168.1.100,1433"
# export TRIVIA_DB_DATABASE="TriviaDB"
# export TRIVIA_DB_USER="sa"
# export TRIVIA_DB_PASSWORD="MiPassword123"

# Para hacerlas permanentes en Linux/Mac, agregarlas a:
# ~/.bashrc (bash)
# ~/.zshrc (zsh)

# ============================================
# PRIORIDAD DE CONFIGURACIÓN
# ============================================
# 1. Variables individuales (TRIVIA_DB_*)
# 2. Connection string completo (TRIVIA_CONNECTION_STRING)
# 3. Valor por defecto (Windows Authentication en localhost)

# ============================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================

# EJEMPLO 1: SQL Server local con autenticación SQL
# TRIVIA_DB_SERVER=localhost
# TRIVIA_DB_DATABASE=TriviaDB
# TRIVIA_DB_USER=sa
# TRIVIA_DB_PASSWORD=MiPassword123

# EJEMPLO 2: SQL Server remoto con IP y puerto
# TRIVIA_DB_SERVER=192.168.1.100,1433
# TRIVIA_DB_DATABASE=TriviaDB
# TRIVIA_DB_USER=usuario_trivia
# TRIVIA_DB_PASSWORD=Password123!

# EJEMPLO 3: SQL Server Express local
# TRIVIA_DB_SERVER=.\SQLEXPRESS
# TRIVIA_DB_DATABASE=TriviaDB
# TRIVIA_DB_USER=sa
# TRIVIA_DB_PASSWORD=Password123

# EJEMPLO 4: SQL Server con named instance
# TRIVIA_DB_SERVER=SERVIDOR\INSTANCIA
# TRIVIA_DB_DATABASE=TriviaDB
# TRIVIA_DB_USER=usuario
# TRIVIA_DB_PASSWORD=password

# EJEMPLO 5: Windows Authentication (no necesita user/password)
# No configurar ninguna variable, el sistema usará el default:
# Server=localhost;Database=TriviaDB;Integrated Security=true;TrustServerCertificate=true;

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
# - NO incluir este archivo con valores reales en el control de versiones
# - NO compartir las credenciales
# - Usar contraseñas seguras
# - Considerar usar Windows Authentication cuando sea posible
# - En producción, usar Azure Key Vault o similar para secretos
